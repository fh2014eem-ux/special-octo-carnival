# ==========================================
# نظام إدارة الشكاوى - متغيرات البيئة
# ==========================================

# رابط الاتصال بقاعدة البيانات
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# رابط الـ API للواجهة الأمامية
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# رابط سكريبت جوجل
NEXT_PUBLIC_SCRIPT_URL="https://script.google.com/macros/s/xxx/exec"

# تفعيل البيانات التجريبية
USE_MOCK_DATA="false"
# Better Auth
BETTER_AUTH_SECRET=ضع_قيمة_عشوائية_طويلة_هنا
BETTER_AUTH_URL=http://localhost:3000

# تشغيل البيانات التجريبية عند الحاجة فقط
USE_MOCK_DATA=false
