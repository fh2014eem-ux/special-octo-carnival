# ==========================================
# نظام إدارة الشكاوى - متغيرات البيئة
# ==========================================

# رابط الاتصال بقاعدة البيانات
DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=public"
# رابط اتصال مباشر لاستخدامه مع Prisma Migrate عند مزود قاعدة البيانات الذي يوفر اتصالاً مباشراً
PRISMA_DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=public"

# رابط الـ API للواجهة الأمامية
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# رابط سكريبت جوجل
NEXT_PUBLIC_SCRIPT_URL="https://script.google.com/macros/s/xxx/exec"

# Better Auth
BETTER_AUTH_SECRET=ضع_قيمة_عشوائية_طويلة_هنا
BETTER_AUTH_URL=http://localhost:3000

# تشغيل البيانات التجريبية محلياً فقط. يجب أن تكون false في Vercel Production.
USE_MOCK_DATA=false

# تكامل Google Drive/Sheets (تُضبط على الخادم فقط بعد إعداد حساب خدمة/ OAuth)
